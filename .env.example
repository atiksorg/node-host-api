# .env.example — скопировать в /var/nodehost/.env и заполнить

# Домен второго уровня (wildcard DNS: *.domain.com → IP сервера)
BASE_DOMAIN=example.com

# Токен для авторизации API-запросов (сгенерируйте случайную строку)
MASTER_TOKEN=your-super-secret-token-here

# Порт управляющего API
API_PORT=8080

# Директории данных (не менять без необходимости)
DATA_DIR=/var/nodehost
APPS_DIR=/var/nodehost/apps
DB_PATH=/var/nodehost/db/platform.db
LOGS_DIR=/var/nodehost/logs

# Адрес Caddy Admin API
CADDY_API=http://localhost:2019
